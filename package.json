{
  "name": "familyflow-app",
  "version": "3.10.0",
  "private": true,
  "type": "module",
  "description": "FamilyFlow: één app voor het hele gezin. Dagprogramma, huiskamer met levende avatars, klussen, coaching en hulp bij ruzie.",
  "scripts": {
    "dev": "node preview/dev.mjs",
    "build": "node preview/build.mjs",
