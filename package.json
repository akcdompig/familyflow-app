    "build:v1": "FF_UI=v1 node preview/build.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.2",
    "playwright": "1.56.0"
  }
}
